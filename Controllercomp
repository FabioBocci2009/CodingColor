#CodingColor

// ==============================
// MODEL - Variabili e dati
// ==============================

let colori = [];
let parola = "";
let d = new Date();


// ==============================
// CONTROLLER - Gestione programma
// ==============================

// Verifica esecuzione e visualizzazione della data
console.log("Verifica esecuzione");
console.log("data:", d);

document.getElementById("saluto").innerHTML =
    "Oggi è il " + d.toLocaleString();


// Funzione principale: acquisizione e controllo dei dati
function elabora() {

    parola = document.getElementById("inParola").value;

    let numero = document.getElementById("inNumber").value;

    // Controllo dei dati inseriti
    if (parola === "") {
        document.getElementById("error").innerHTML =
            "Inserisci una parola!";
    }
    else if (numero === "") {
        document.getElementById("error").innerHTML =
            "Inserisci un numero!";
    }
    else {

        numero = Number(numero);

        // Verifica che il numero sia compreso tra 0 e 255
        if (numero < 0 || numero > 255 || !Number.isInteger(numero)) {

            document.getElementById("error").innerHTML =
                "Il numero non rispetta il criterio";

            document.getElementById("inNumber").value = "";

        } else {

            document.getElementById("error").innerHTML = "Errori";

            // Inserimento del numero nell'array RGB
            colori.push(numero);

            console.log(colori);

            document.getElementById("inNumber").value = "";

            // Creazione del colore dopo aver inserito tre numeri
            if (colori.length === 3) {

                let newColor =
                    `rgb(${colori[0]}, ${colori[1]}, ${colori[2]})`;

                console.log("Colore creato:", newColor);

                document.getElementById("outText").innerHTML = parola;

                document.getElementById("outText").style.color = newColor;

                document.getElementById("outText").style.fontSize = "40px";

                // Svuotamento dell'array
                colori = [];
            }
        }
    }
}


// Funzione per cancellare gli inserimenti e ripristinare la pagina
function reset() {

    document.getElementById("inNumber").value = "";
    document.getElementById("inParola").value = "";

    document.getElementById("outText").innerHTML = "Output";

    document.getElementById("outText").style.color = "black";

    document.getElementById("error").innerHTML = "Errori";

    colori = [];
    parola = "";
}

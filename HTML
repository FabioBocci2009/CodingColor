# CodingColor

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <title>Coding&Color - 4AI</title>
    <link href="view.css" rel="stylesheet" type="text/css" />
</head>

<body>

    <div id="header">
        <h1 id="saluto">Oggi è un bel giorno!</h1>
    </div>

    <div id="title">
        <h1>CODICI E COLORI</h1>
    </div>

    <div id="input">

        <label for="inParola">Inserisci una parola:</label>
        <input id="inParola" placeholder="Inserisci una parola">

        <label for="inNumber">Inserisci un numero RGB:</label>
        <input type="number" id="inNumber" placeholder="Da 0 a 255">

        <button type="button" id="btnElabora" onclick="elabora()">
            Elabora
        </button>

        <button type="button" id="btnCancella" onclick="reset()">
            Cancella
        </button>

    </div>

    <div id="output">
        <p id="outText">Output</p>
    </div>

    <div>
        <p id="error">Errori</p>
    </div>

    <script src="Controllercomp.js"></script>

</body>
</html>

# CodingColor

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <title>Coding&Color - 4AI</title>

    <!-- Collegamento al foglio di stile CSS -->
    <link href="view.css" rel="stylesheet" type="text/css" />
</head>

<body>

    <!-- Intestazione con il saluto e la data -->
    <div id="header">
        <h1 id="saluto">Oggi è un bel giorno!</h1>
    </div>

    <!-- Titolo principale della pagina -->
    <div id="title">
        <h1>CODICI E COLORI</h1>
    </div>

    <!-- Sezione dedicata all'inserimento dei dati -->
    <div id="input">

        <label for="inParola">Inserisci una parola:</label>
        <input id="inParola" placeholder="Inserisci una parola">

        <label for="inNumber">Inserisci un numero RGB:</label>
        <input type="number" id="inNumber" placeholder="Da 0 a 255">

        <!-- Pulsanti per elaborare i dati e cancellare gli inserimenti -->
        <button type="button" id="btnElabora" onclick="elabora()">
            Elabora
        </button>

        <button type="button" id="btnCancella" onclick="reset()">
            Cancella
        </button>

    </div>

    <!-- Sezione in cui viene visualizzata la parola colorata -->
    <div id="output">
        <p id="outText">Output</p>
    </div>

    <!-- Sezione dedicata alla visualizzazione degli errori -->
    <div>
        <p id="error">Errori</p>
    </div>

    <!-- Collegamento ai file JavaScript: prima Model e poi Controller -->
    <script src="model.js"></script>
    <script src="Controllercomp.js"></script>

</body>
</html>
